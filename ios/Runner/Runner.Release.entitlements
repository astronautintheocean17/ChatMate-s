<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release/App Store builds talk to the production APNs host. A
	     "development" entitlement in a release build signs fine but every
	     notification is rejected by APNs, so this file differs from
	     Runner.entitlements in exactly one value. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
