<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push. Requires an Apple Developer Program account:
	     Xcode → Runner target → Signing & Capabilities → + Push Notifications,
	     and an APNs auth key (.p8) uploaded to Firebase.
	     Until then this file is harmless and iOS just never receives pushes. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
